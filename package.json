{
	"name": "@fortemate/dicechess-evaluation-playground",
	"private": true,
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"author": "Jegors Čemisovs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fortemate/dicechess-evaluation-playground.git"
	},
	"homepage": "https://github.com/fortemate/dicechess-evaluation-playground#readme",
	"bugs": {
		"url": "https://github.com/fortemate/dicechess-evaluation-playground/issues"
	},
	"type": "module",
	"engines": {
		"node": "^26.0.0",
		"npm": ">=11.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"overrides": {
		"cookie": "0.7.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.5.1",
		"@vitest/coverage-v8": "^5.0.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@lichess-org/chessground": "10.1.1",
		"jose": "^6.2.12"
	}
}
