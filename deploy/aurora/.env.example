#
# Copy this file to deploy/aurora/.env and fill every value locally.
# Image references must use registry/repository@sha256:<64 lowercase hex>.
# MODEL_PACKAGE_DIR must contain model.onnx and manifest.json.
# Keep the populated file outside Git and readable only by the operator.

PLAYGROUND_IMAGE=
EVALUATOR_IMAGE=
PLAYGROUND_LOOPBACK_PORT=
MODEL_PACKAGE_DIR=
MODEL_MANIFEST_SHA256=
EVALUATION_INTERNAL_TOKEN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
